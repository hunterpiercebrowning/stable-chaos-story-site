{
  "name": "stable-chaos-story-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --port 8788",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply stable-chaos-context --local",
    "db:migrate:remote": "wrangler d1 migrations apply stable-chaos-context --remote",
    "seed": "node scripts/seed-link.mjs"
  },
  "dependencies": {
    "motion": "^12.34.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.14.0",
    "three": "^0.183.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.45.0"
  }
}
